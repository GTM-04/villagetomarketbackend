        {
          "name": "List All Listings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/listings/?page=1&page_size=20",
              "host": ["{{base_url}}"],
              "path": ["listings", ""],
