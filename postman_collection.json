            "body": {
              "mode": "raw",
              "raw": "{\n  \"produce_type_id\": 1,\n  \"quantity_available\": 100,\n  \"unit\": \"kg\",\n  \"price_per_unit\": 2.50,\n  \"description\": \"Fresh organic tomatoes from my farm\",\n  \"is_organic\": true,\n  \"harvest_date\": \"2026-02-15\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/listings/",
